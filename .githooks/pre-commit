#!/bin/sh
# Lint before each commit. Enable with `just install-hooks`
# (git config core.hooksPath .githooks).
set -eu

if ! cargo fmt --check >/dev/null 2>&1; then
    echo "pre-commit: code isn't formatted; run \`cargo fmt\` (or \`just fmt\`)." >&2
    exit 1
fi

if ! cargo clippy --all-targets --quiet -- -D warnings; then
    echo "pre-commit: fix the clippy warnings above." >&2
    exit 1
fi
